{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "perf": "error",
    "suspicious": "error",
  },
  "ignorePatterns": [
    // Generated by Wails.
    "bindings/**",
    // Generated build output.
    "dist/**",
  ],
  "options": {
    "typeAware": true,
  },
  "plugins": [
    "eslint",
    "import",
    "jsx-a11y",
    "oxc",
    "promise",
    "react",
    "typescript",
    "unicorn",
  ],
  "rules": {
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css", "@fontsource-variable/*", "@/i18n", "i18next"],
      },
    ],
    // TypeScript uses the React automatic JSX runtime.
    "react/react-in-jsx-scope": "off",
    "typescript/no-floating-promises": [
      "error",
      {
        "ignoreVoid": true,
      },
    ],
    // ES2020 has no Array.prototype.toSorted; fresh copies are safe to sort.
    "unicorn/no-array-sort": [
      "error",
      {
        "allowAfterSpread": true,
      },
    ],
  },
}
