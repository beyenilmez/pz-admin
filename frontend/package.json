{
  "name": "pz-admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "tsc && vite build --minify false --mode development",
    "build": "tsc && vite build --mode production",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm check:translations && pnpm lint && pnpm format:check && tsc && pnpm test:run",
    "check:translations": "node ./scripts/translations/validate-ui.mjs",
    "format": "pnpm format:translations && cd .. && prettier --write .",
    "format:translations": "node ./scripts/translations/format.mjs --write",
    "format:check": "node ./scripts/translations/format.mjs --check && cd .. && prettier --check .",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives src website scripts vite.config.ts vite.website.config.ts vitest.config.ts .storybook",
    "lint:fix": "oxlint --deny-warnings --report-unused-disable-directives --fix src website scripts vite.config.ts vite.website.config.ts vitest.config.ts .storybook",
    "scrape:vehicles:42": "node ./scripts/catalogs/vehicles/scrape-build-42.mjs",
    "generate:icons": "node ./scripts/icons/generate.mjs",
    "generate:items": "node ./scripts/catalogs/items/generate.mjs",
    "generate:vehicles": "node ./scripts/catalogs/vehicles/generate.mjs",
    "generate:options:reference": "node ./scripts/catalogs/options/generate-reference.mjs",
    "generate:items:translations": "node ./scripts/translations/generate-items.mjs",
    "generate:skills:translations": "node ./scripts/translations/generate-skills.mjs",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "storybook:build": "storybook build",
    "generate:screenshots": "node scripts/screenshots/export.mjs",
    "website:dev": "vite --config vite.website.config.ts",
    "website:build": "tsc && vite build --config vite.website.config.ts",
    "website:preview": "vite preview --config vite.website.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/noto-sans": "5.3.0",
    "@mantine/carousel": "9.7.2",
    "@mantine/core": "9.7.2",
    "@mantine/form": "9.7.2",
    "@mantine/hooks": "9.7.2",
    "@mantine/notifications": "9.7.2",
    "@mantine/tiptap": "9.7.2",
    "@tabler/icons-react": "3.49.0",
    "@tiptap/extension-color": "3.31.4",
    "@tiptap/extension-text-align": "3.31.4",
    "@tiptap/extension-text-style": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@wailsio/runtime": "3.0.0-beta.28",
    "embla-carousel": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "i18next": "26.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "cheerio": "1.2.0",
    "jsdom": "30.1.2",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "playwright": "1.64.0",
    "postcss-preset-mantine": "1.18.0",
    "prettier": "3.9.10",
    "storybook": "10.6.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  }
}
